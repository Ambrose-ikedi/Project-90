# Copy to .env for local development. Never commit real credentials.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
PROJECT90_DB_PATH=data/project90.db

# First administrator account (created only if no admin exists)
PROJECT90_ADMIN_NAME=Project 90 Administrator
PROJECT90_ADMIN_EMAIL=admin@example.org
PROJECT90_ADMIN_USERNAME=admin
PROJECT90_ADMIN_PASSWORD=ChangeThisImmediately123!
